# Copy to .env.local. Existing settings should be preserved when adding new keys.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ANALYTICS_HOST=skylakearis.github.io
# Optional: discovered automatically from the hostname when empty.
CLOUDFLARE_SITE_TAG=

# Optional engagement statistics. setup:analytics fills these after deployment.
CLOUDFLARE_ENGAGEMENT_URL=
CLOUDFLARE_ENGAGEMENT_READ_TOKEN=

# Deployment only: Workers Scripts Edit and D1 Edit.
# The read-only Web Analytics token does not need broader permissions.
CLOUDFLARE_DEPLOY_TOKEN=
